{
  "app_id": "cli_REPLACE_ME",
  "transport": "ws",
  "teacher_open_id": "ou_xxxxxxxxxxxxxxxxxxxx",
  "teacher_name": "Owner",
  "http": {
    "host": "127.0.0.1",
    "port": 8310
  },
  "paths": {
    "db": "/data/larkrelay/db/relay.sqlite",
    "files": "/data/larkrelay/files",
    "outgoing": "/data/larkrelay/outgoing"
  },
  "limits": {
    "max_download_mb": 100,
    "files_soft_quota_gb": 10,
    "files_hard_quota_gb": 15,
    "min_free_gb": 2
  },
  "reconcile": {
    "interval_sec": 300,
    "overlap_sec": 600
  },
  "watchdog": {
    "disconnected_exit_sec": 180,
    "alert_cooldown_sec": 3600
  },
  "webhook": {
    "path": "/lark/events"
  },
  "oauth": {
    "redirect_uri": "http://localhost:8310/lark/oauth/callback",
    "callback_path": "/lark/oauth/callback",
    "_comment": "redirect_uri 登记成 localhost 即可，不需要公网可达：授权后把浏览器地址栏整条粘给 relay auth --callback-url。想自动化再改成公网地址并把 callback_path 挂到反向代理。"
  },
  "archive": {
    "interval_sec": 300
  }
}
